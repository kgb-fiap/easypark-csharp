{
  "ConnectionStrings": {
    "Default": ""
  },
  "Authentication": {
    "ApiKey": "easypark-local-key"
  },
  "ExternalServices": {
    "Eta": {
      "HealthUrl": "https://maps.googleapis.com"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "EasyPark.Api",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/easypark-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "EasyPark.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
