{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "EasyPark.Api",
    "Audience": "EasyPark.Client",
    "SecretKey": "easypark-super-secret-key-change-me",
    "ExpirationMinutes": 120
  },
  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "easypark",
    "AuditCollectionName": "audit_events"
  },
  "ExternalServices": {
    "Eta": {
      "HealthUrl": "https://maps.googleapis.com"
    }
  },
  "OpenTelemetry": {
    "ServiceName": "EasyPark.Api",
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/easypark-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "EasyPark.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
